rules_version = '2';

// Regras do Firestore do projeto Agrovia DRE Frota.
// Colar este conteúdo em: Consola Firebase > Firestore Database > Regras > Publicar.
// A gravação da quarentena é feita só pelo validar_entrada.py com a chave de serviço (ignora estas regras).
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function temPerfil() {
      return logado() && exists(/databases/$(database)/documents/perfis/$(request.auth.uid));
    }

    function perfil() {
      return get(/databases/$(database)/documents/perfis/$(request.auth.uid)).data;
    }

    function liberado() {
      return temPerfil() && perfil().ativo == true && perfil().deve_trocar_senha == false;
    }

    function adm() {
      return liberado() && perfil().papel == 'ADM';
    }

    function perfilValido(d) {
      return d.keys().hasAll(['apelido', 'nome', 'celular', 'papel', 'ativo', 'deve_trocar_senha'])
        && d.apelido is string && d.apelido.matches('^[a-z0-9._-]{3,30}$')
        && d.nome is string && d.nome.size() > 1 && d.nome.size() <= 80
        && d.celular is string && d.celular.matches('^[0-9]{11}$')
        && d.papel in ['ADM', 'USUARIO']
        && d.ativo is bool
        && d.deve_trocar_senha is bool;
    }

    match /perfis/{uid} {
      allow read: if adm() || (logado() && request.auth.uid == uid);

      // Só o ADM cadastra; todo usuário novo nasce com troca de senha obrigatória.
      allow create: if adm()
        && perfilValido(request.resource.data)
        && request.resource.data.deve_trocar_senha == true
        && request.resource.data.ativo == true;

      // ADM gere os outros (não muda apelido); sobre si próprio não pode tirar o papel nem bloquear-se.
      // O usuário só pode passar deve_trocar_senha de true para false (depois de trocar a senha).
      allow update: if (
          adm()
          && perfilValido(request.resource.data)
          && request.resource.data.apelido == resource.data.apelido
          && (uid != request.auth.uid
              || (request.resource.data.papel == 'ADM' && request.resource.data.ativo == true))
        ) || (
          logado() && request.auth.uid == uid
          && resource.data.deve_trocar_senha == true
          && request.resource.data.deve_trocar_senha == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deve_trocar_senha', 'senha_trocada_em'])
        );

      allow delete: if false;
    }

    match /quarentena/{documento=**} {
      allow read: if liberado();
      allow write: if false;
    }
  }
}
